# Run python scripts/setup_env.py to generate .env with a unique secret.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_HTTPS_ONLY=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_SECONDS=45
EMBEDDING_MODEL=intfloat/multilingual-e5-small
DOCUMENT_CHUNK_MAX_TOKENS=256
DOCUMENT_CHUNK_TARGET_TOKENS=224
DOCUMENT_MAX_CHUNKS=256
DOCUMENT_EMBED_BATCH_SIZE=16
DOCUMENT_INDEX_BUDGET_SECONDS=240
DOCUMENT_INDEX_LEASE_SECONDS=300
GUNICORN_THREADS=3
RAG_SCORE_THRESHOLD=0.55
RAG_TOP_K=3
RAG_INSUFFICIENT_MESSAGE=I couldn't find published information to answer “{question}” yet.
CHAT_RATE_LIMIT_PER_MINUTE=30
API_RATE_LIMIT_PER_MINUTE=30
PUBLIC_BASE_URL=http://localhost:8080
